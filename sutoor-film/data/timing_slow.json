 "hemistichs": {
  "v1a": {
   "start": 4.5,
   "end": 7.591,
   "text": "يُدَفِّنُ بَعضُنا بَعضاً وَتَمشي"
  },
  "v1b": {
   "start": 8.191,
   "end": 9.953,
   "text": "أَواخِرُنا عَلى هامِ الأَوالي"
  },
  "v2a": {
   "start": 11.103,
   "end": 12.909,
   "text": "نُعِدُّ المَشرَفِيَّةَ وَالعَوالي"
  },
  "v2b": {
   "start": 13.509,
   "end": 15.401,
   "text": "وَتَقتُلُنا المَنونُ بِلا قِتالِ"
  },
  "v3a": {
   "start": 16.551,
   "end": 18.532,
   "text": "وَنَرتَبِطُ السَوابِقَ مُقرَباتٍ"
  },
  "v3b": {
   "start": 19.132,
   "end": 21.046,
   "text": "وَما يُنجينَ مِن خَبَبِ اللَيالي"
  },
  "v4a": {
   "start": 22.196,
   "end": 24.48,
   "text": "وَهانَ فَما أُبالي بِالرَزايا"
  },
  "v4b": {
   "start": 25.08,
   "end": 26.929,
   "text": "لِأَنّي ما اِنتَفَعتُ بِأَن أُبالي"
  },
  "v5a": {
   "start": 28.079,
   "end": 30.582,
   "text": "رَماني الدَهرُ بِالأَرزاءِ حَتّى"
  },
  "v5b": {
   "start": 31.205,
   "end": 32.987,
   "text": "فُؤادي في غِشاءٍ مِن نِبالِ"
  },
  "v6a": {
   "start": 34.137,
   "end": 35.921,
   "text": "فَصِرتُ إِذا أَصابَتني سِهامٌ"
  },
  "v6b": {
   "start": 36.521,
   "end": 38.717,
   "text": "تَكَسَّرَتِ النِصالُ عَلى النِصالِ"
  }
 },
